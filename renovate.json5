{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Where the manifests live in THIS repo.
  flux: {
    managerFilePatterns: [
      '/^kubernetes/.+\\.ya?ml$/'
    ]
  },
  kubernetes: {
    managerFilePatterns: [
      '/^kubernetes/.+\\.ya?ml$/'
    ]
  },
  'helm-values': {
    managerFilePatterns: [
      '/^kubernetes/.*values\\.ya?ml$/'
    ]
  },

  packageRules: [
    {
      description: 'k0s releases use a numeric build suffix',
      matchDatasources: ['github-releases'],
      matchPackageNames: ['k0sproject/k0s'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k0s\\.(?<build>\\d+)$',
    },
    {
      description: 'wait4x floats on :latest',
      matchPackageNames: ['wait4x/wait4x'],
      pinDigests: true
    },
  ],

  customManagers: [
    {
      customType: 'regex',
      description: 'k0s Helm extensions (helm.k0sproject.io/v1beta1 Chart)',
      managerFilePatterns: ['/^kubernetes/k0s/extensions-helm/.+\\.ya?ml$/'],
      matchStrings: [
        'chartName:\\s*oci://(?<depName>\\S+)\\s+version:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'annotated one-offs',
      managerFilePatterns: ['/^kubernetes/.+\\.ya?ml$/', '/^docker/.+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+version:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
  ],
}
