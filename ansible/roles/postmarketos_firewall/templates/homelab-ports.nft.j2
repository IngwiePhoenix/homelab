#!/usr/sbin/nft -f
# Managed by Ansible. postmarketOS loads this file from /etc/nftables.d/.
# Keep this file ordered before 99_drop_log.nft so explicit allows are applied
# before the default terminal drop rule.

table inet filter {
    chain input {
{% for port in ((firewall_ports | default([])) + (firewall_ports_extra | default([]))) | unique %}
        {{ port.split('/') | last }} dport {{ port.split('/') | first }} accept comment "Managed by Ansible"
{% endfor %}
    }
}
